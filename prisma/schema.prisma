// Prisma 7: URL config moved to prisma.config.ts
// Runtime adapter configured in src/lib/db.ts via @neondatabase/serverless

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5 required models) ───────────────────
/// One person. A User with a business is an owner; a User with a
/// verified phone is a customer; the same person can be both.
///
/// email is no longer required: a customer signs in with a phone they
/// prove over WhatsApp and may never give an address at all. Owners
/// still sign in with email and password, so one of the two must be
/// present — enforced in the application, because a partial unique
/// index cannot express "at least one of".
model User {
  id            String    @id @default(cuid())
  name          String?
  /// Stored lower-cased (every writer lower-cases; sign-in matches
  /// case-insensitively). Production also carries a unique index on
  /// lower(email), "User_email_lower_key", which Prisma cannot express:
  /// phase18_email_change.sql adds it, and `prisma db push` / `migrate
  /// diff` would see it as drift and drop it. Migrations here are
  /// hand-written SQL, never those commands, for this among other reasons.
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  /// E.164 digits without the plus, e.g. "201234567890" or
  /// "966501234567" (src/lib/phone.ts). The key a customer's bookings are
  /// found by, which is why it only counts once verified.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// What the customer wants to hear about. Owners have their own
  /// settings elsewhere.
  notifyByWhatsApp Boolean  @default(true)
  notifyByEmail    Boolean  @default(true)
  /// Off until an SMS gateway is configured; see lib/notifications.
  notifyBySms      Boolean  @default(false)
  /// Deprecated in favour of adminRole; kept so a token minted before
  /// roles existed still resolves. Nothing reads it to decide access.
  isAdmin          Boolean  @default(false)
  /// What this account may administer. Null for everybody who is not an
  /// administrator, which is almost everybody.
  adminRole        AdminRole?
  /// Every web session signed in before this moment is refused on its
  /// next check (lib/security/session-policy.ts). Set by a password
  /// reset and by "sign out everywhere".
  sessionsRevokedAt DateTime?
  /// Bookings under this account's phone made before this moment are
  /// not shown to it. Set when the number was released by a deleted
  /// account (PhoneRelease), so the next holder of a recycled number
  /// does not inherit the previous holder's appointments.
  historySince      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  business      Business?
  emailTokens   EmailVerificationToken[]
  onboardingDraft OnboardingDraft?
  favorites     Favorite[]
  notifications Notification[]

  /// The staff member this account signs in as, if any.
  staffMember    StaffMember?

  /// Native app sessions and the devices push goes to.
  mobileSessions MobileSession[]
  deviceTokens   DeviceToken[]

  /// Payments this person keyed in by hand, and refunds they issued.
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")
  refundsIssued    Refund[]  @relation("RefundActor")

  @@index([phone])
}

/// A one-time code sent to a phone to sign in.
///
/// Separate from PhoneVerification, which belongs to a business proving
/// its own number. This one has no business and no session behind it,
/// so it carries its own throttling.
model LoginCode {
  id         String   @id @default(cuid())
  /// E.164. Not unique: an expired row is kept until cleaned up.
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
}

/// A business a customer has saved.
///
/// Replaces the per-device list in localStorage, which was lost on a
/// new phone and could not be acted on by anything server-side.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId, createdAt])
  @@index([businessId])

}

/// Something that happened that the customer should know about.
///
/// Written when a booking changes state, so the account can show a
/// history of it rather than only the current status.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  /// Where tapping it should go, relative to the site root.
  href      String?
  bookingId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationKind {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
  BOOKING_STARTING_SOON
  BOOKING_COMPLETED
  REVIEW_REQUEST
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  SUBSCRIPTION_RENEWAL_DUE
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_RENEWED
  GENERAL
}

/// How a notification reached somebody.
enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  /// Native app. Dormant until something is wired to send on it, the
  /// same way SMS has been — the dispatcher treats an unconfigured
  /// channel as skipped, not failed.
  PUSH
}

enum DeliveryStatus {
  /// Claimed, not yet handed to the provider. A row left here longer
  /// than a send takes means the process died mid-send; the re-drive
  /// job picks it up (prisma/migrations/phase19_reliability.sql).
  PENDING
  SENT
  SKIPPED
  /// The provider refused or was unreachable. Retried with backoff
  /// while attempts remain; see `nextAttemptAt`.
  FAILED
  /// Given up: every retry failed, or the message stopped being worth
  /// sending (a reminder for an appointment that has passed).
  DEAD
}

/// The record of what has already gone out.
///
/// `dedupeKey` is the whole mechanism for not sending twice: it names
/// the event, its subject and the recipient on one channel, and a
/// sender claims it before sending. A cron that runs twice, a webhook
/// the payment provider retries, or a double-tapped button all compute
/// the same key and the second one finds it taken.
model NotificationDelivery {
  id         String              @id @default(cuid())
  dedupeKey  String              @unique
  kind       NotificationKind
  channel    NotificationChannel
  status     DeliveryStatus
  /// A phone or an email address, so support can answer "did they get
  /// it?". Never the message body — that would put a customer's
  /// details in a second place for no reason.
  recipient  String
  bookingId  String?
  businessId String?
  error      String?
  /// Sends so far, counting the first. The re-drive job stops at
  /// MAX_ATTEMPTS (lib/notifications/outbox.ts) and marks the row DEAD.
  attempts      Int       @default(0)
  /// When a FAILED row may be tried again; null when it may not.
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  /// The event this row was claimed for, so a retry can rebuild the
  /// message from the current booking without the original request.
  event         Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([kind, createdAt])
  @@index([bookingId])
  @@index([businessId])
  @@index([status, nextAttemptAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])

}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Business Models ──────────────────────────────────
model Business {
  id                         String             @id @default(cuid())
  slug                       String             @unique
  nameAr                     String
  nameEn                     String?
  taglineAr                  String?
  phone                      String?
  whatsapp                   String?
  address                    String?
  /// Where the business is, as the owner pinned it — never geocoded or
  /// guessed. Both or neither (a CHECK in add_business_location.sql);
  /// a business without a pin is simply not on the map or in "nearby".
  latitude                   Float?
  longitude                  Float?
  about                      String?            @db.Text
  coverImage                 String?
  logoImage                  String?
  isVerified                 Boolean            @default(false) // earned, not self-set: see lib/verification.ts
  isPublished                Boolean            @default(false) // held back until the owner verifies their email
  /// When true a public booking is created CONFIRMED rather than PENDING.
  /// Off by default, so no existing business changes behaviour until its
  /// owner opts in. Surfaced in discovery as the "instant booking" filter.
  autoConfirm                Boolean            @default(false)
  /// Denormalised from Review so the listing can sort and filter on a
  /// plain indexed column instead of aggregating a join per row.
  /// Kept in sync by recomputeBusinessRating(); null means never rated.
  ratingAvg                  Float?
  ratingCount                Int                @default(0)
  phoneVerifiedAt            DateTime? // set once a WhatsApp OTP is confirmed
  depositEnabled             Boolean            @default(false)
  depositPercent             Int                @default(20)
  // ── Scheduling policy ────────────────────────────────────────
  /// Minutes reserved after every appointment — cleaning, notes, the
  /// walk to the door. Applied on top of the service duration when
  /// deciding whether two bookings collide.
  bufferMinutes              Int                @default(0)
  /// How soon from now a customer may book. 0 means "any time left today".
  minNoticeMinutes           Int                @default(0)
  /// How far ahead the calendar is open.
  maxAdvanceDays             Int                @default(60)
  /// "HH:MM" in Cairo. Past it, today is closed for new bookings even
  /// if slots remain. Null means no cutoff.
  sameDayCutoff              String?
  // ── Subscription ──────────────────────────────────────────
  plan                       Plan               @default(FREE)
  subscriptionStatus         SubscriptionStatus @default(ACTIVE)
  trialEndsAt                DateTime?
  currentPeriodEnd           DateTime?
  pendingPlan                Plan?
  subscriptionPaymobOrderId  String? // Paymob order ID for subscription payment
  subscriptionReminderSentAt DateTime? // prevents duplicate renewal reminder emails

  // ── Where this business stands with us ──────────────────────
  /// isPublished says whether the page is visible. This says why.
  /// A page can be invisible because nobody has looked at it yet,
  /// because it was turned down, or because it was taken down — three
  /// different situations one boolean could not tell apart.
  status                     BusinessStatus @default(APPROVED)
  /// Shown to the owner. A decision with no reason is one they cannot
  /// act on.
  statusNote                 String?
  statusChangedAt            DateTime?
  statusChangedById          String?
  /// Editorially promoted. Separate from isVerified, which is earned by
  /// completing a profile and cannot be granted by anybody.
  isFeatured                 Boolean        @default(false)
  featuredAt                 DateTime?

  // ── What this business wants to be told about ───────────────
  // Every default matches what businesses already receive, so nobody's
  // notifications change until they choose to change them.
  notifyByEmail        Boolean @default(true)
  notifyByWhatsApp     Boolean @default(true)
  notifyNewBooking     Boolean @default(true)
  notifyCancellation   Boolean @default(true)
  notifyPayment        Boolean @default(true)
  /// Where alerts go. Null means the owner's email and the business's
  /// own WhatsApp number, which is what happens today.
  notificationEmail    String?
  notificationPhone    String?

  // ── Reminders ───────────────────────────────────────────────
  reminderEnabled      Boolean @default(true)
  /// How long before the appointment the reminder goes out. 24 is what
  /// the daily job has always sent.
  reminderLeadHours    Int     @default(24)
  /// The second, shorter nudge. Off by default: it is an extra message
  /// to somebody who already had one, which is the business's call.
  startingSoonEnabled  Boolean @default(false)
  startingSoonLeadMins Int     @default(120)
  reviewRequestEnabled Boolean @default(true)
  // ── Referrals ─────────────────────────────────────────────
  referralCode               String?            @unique // 8-char uppercase code e.g. "A3F7C2D1"
  referredById               String? // businessId that referred this business
  referralRewardedAt         DateTime? // set once referrer receives their 30-day bonus
  // ── Business Type ────────────────────────────────────────────
  businessType               BusinessType       @default(GENERAL)

  // ── Setup and verification (phase21_saas.sql) ───────────────
  /// The owner pressed Publish. A business only goes live once this is
  /// set AND its readiness checklist passes (lib/business/readiness.ts);
  /// an email verified later completes a publish that was waiting on it.
  publishRequestedAt         DateTime?
  /// The owner reviewed the booking policies (confirmation, notice,
  /// cancellation window). Part of the readiness checklist.
  policiesReviewedAt         DateTime?
  /// How close to an appointment a customer may still cancel or move it.
  cancellationCutoffHours    Int                @default(2)
  /// Ownership or identity checked by a Maw3ed administrator, from
  /// evidence, and nothing else. The public "موثّق" badge (isVerified)
  /// follows this. A confirmed email or phone is contact verification,
  /// not this.
  identityVerifiedAt         DateTime?
  identityVerifiedById       String?
  identityVerificationNote   String?

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Optional, and narrower than the city. Null means "somewhere in the city".
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  services     Service[]
  availability AvailabilityRule[]
  bookings     Booking[]
  customers    Customer[]
  tables       Table[]
  staffMembers StaffMember[]

  referredBy Business?  @relation("BusinessReferrals", fields: [referredById], references: [id])
  referrals  Business[] @relation("BusinessReferrals")

  phoneVerifications PhoneVerification[]
  payments           Payment[]
  profileViews       ProfileView[]
  discounts          Discount[]
  reviews            Review[]
  images             BusinessImage[]
  branches           Branch[]
  timeBlocks         TimeBlock[]
  resources          Resource[]
  favorites          Favorite[]
  importBatches      ImportBatch[]

  /// The discovery listing always filters on isPublished first, then on
  /// one of city / neighbourhood / category, and sorts on rating,
  /// bookings or price. These cover that shape.
  @@index([isPublished, cityId])
  @@index([isPublished, categoryId])
  @@index([isPublished, neighborhoodId])
  @@index([isPublished, ratingAvg])
  @@index([isPublished, createdAt])
  @@index([referredById])
  /// The nearby query's bounding box (add_business_location.sql).
  @@index([latitude, longitude])

}

/// A physical location. Optional: most businesses have exactly one
/// place and never create a branch, in which case bookings carry a null
/// branchId and the profile shows the business address as it always has.
model Branch {
  id         String   @id @default(cuid())
  businessId String
  nameAr     String
  nameEn     String?
  address    String?
  /// The branch's own pin, as the owner set it. Both or neither.
  latitude   Float?
  longitude  Float?
  phone      String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  timeBlocks TimeBlock[]
  resources  Resource[]

  @@index([businessId, isActive, sortOrder])
  /// The nearby query's bounding box (add_business_location.sql).
  @@index([latitude, longitude])
}

/// Time removed from the calendar, for any reason.
///
/// Either weekly (dayOfWeek set) or dated (startsOn/endsOn set); a row
/// with neither is ignored rather than treated as "always". Leaving
/// startTime and endTime null means the whole day.
model TimeBlock {
  id            String        @id @default(cuid())
  businessId    String
  /// Null means the whole business is affected.
  staffMemberId String?
  /// Null means every branch.
  branchId      String?
  kind          TimeBlockKind
  /// Weekly form: 0 = Sunday.
  dayOfWeek     Int?
  /// Dated form, inclusive of both ends, stored as UTC midnight.
  startsOn      DateTime?
  endsOn        DateTime?
  /// "HH:MM". Null for an all-day block.
  startTime     String?
  endTime       String?
  reason        String?
  createdAt     DateTime      @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
  @@index([businessId, startsOn, endsOn])
  @@index([staffMemberId])
  @@index([branchId])

}

model Category {
  id      String @id @default(cuid())
  slug    String @unique
  nameAr  String
  nameEn  String
  icon    String @default("🏢")
  color   String @default("#6B7280")
  bgColor String @default("#F3F4F6")

  /// Null for a top-level category. One level deep is deliberate: a
  /// subcategory of a subcategory is a taxonomy nobody navigates.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  businesses Business[]

  @@index([parentId])
}

model City {
  id     String @id @default(cuid())
  slug   String @unique
  nameAr String
  nameEn String

  businesses    Business[]
  neighborhoods Neighborhood[]
}

/// A district inside a city — Maadi, Zamalek, Sheikh Zayed. Optional on a
/// business, because most owners will only ever pick a city.
model Neighborhood {
  id     String @id @default(cuid())
  slug   String
  nameAr String
  nameEn String

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  businesses Business[]

  /// Slugs only have to be unique inside their city: two governorates may
  /// each have a "wasat el balad".
  @@unique([cityId, slug])
  @@index([cityId])
}

model Service {
  id            String   @id @default(cuid())
  businessId    String
  nameAr        String
  nameEn        String?
  descriptionAr String?
  duration      Int // minutes
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("EGP")
  isAvailable   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]
  staff    StaffService[]

  /// The price-range filter and the cheapest-service lookup both read
  /// this ordering directly.
  @@index([businessId, isAvailable, price])
}

/// A rating left against one completed booking.
///
/// Tied to the booking rather than to the customer, so a review can only
/// exist where a real appointment happened, and nobody can leave two for
/// the same visit. The write path is not built yet — this table stays
/// empty until it is, and the listing reports zero rather than inventing
/// a number.
model Review {
  id         String   @id @default(cuid())
  businessId String
  /// One review per booking, enforced by the database, not by app code.
  bookingId  String   @unique
  rating     Int /// 1..5, range-checked in app code
  comment    String?  @db.Text
  /// What the customer attached, as Cloudinary URLs.
  photos     String[] @default([])
  /// The owner's public reply. One per review, editable, and shown
  /// underneath it rather than as a separate review.
  response    String?   @db.Text
  respondedAt DateTime?

  /// Whether this review appears and counts.
  ///
  /// The rule the whole system rests on: anything that is not PUBLISHED
  /// is absent from the list, the count, the average and the
  /// distribution alike. A page that said "127 reviews" above 126 of
  /// them would be worse than showing nothing.
  status         ReviewStatus @default(PUBLISHED)
  /// For the next moderator, never shown publicly.
  moderationNote String?      @db.Text
  moderatedAt    DateTime?
  moderatedById  String?
  /// Set the first time the author rewrites it, so the page can say so
  /// rather than quietly showing different words than were voted on.
  editedAt       DateTime?
  /// Follows ReviewVote, which is the truth. Denormalised so "most
  /// helpful" is an index scan and not a count per row.
  helpfulCount   Int          @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  votes    ReviewVote[]
  reports  ReviewReport[]

  @@index([businessId, createdAt])
  /// Backs the rating filter and the "highest/lowest first" sorts.
  @@index([businessId, rating])
  /// Every public query filters on status, so it leads these.
  @@index([businessId, status, createdAt])
  @@index([businessId, status, rating])
  @@index([businessId, status, helpfulCount])
  @@index([status])
}

enum ReviewStatus {
  /// Visible, and counts toward the rating.
  PUBLISHED
  /// Reported and awaiting a look. Still visible: hiding on accusation
  /// alone would make the report button a censorship button.
  UNDER_REVIEW
  /// Taken down by a moderator. Invisible, uncounted, restorable.
  HIDDEN
  /// Withdrawn by its own author.
  REMOVED
}

/// One vote per review per device.
///
/// The voter is a hash of the device id together with the review id, so
/// two rows cannot be joined up into a picture of what one person has
/// read.
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  voterHash String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, voterHash])
}

/// Somebody complained about a review.
model ReviewReport {
  id       String       @id @default(cuid())
  reviewId String
  reason   ReportReason
  /// In their words. Optional.
  detail   String?      @db.Text
  /// Hashed, for rate limiting and for spotting one person reporting
  /// everything. Never an address and never a name.
  reporterHash String
  /// True when the business being reviewed is the one complaining, so a
  /// moderator knows who is asking.
  byBusiness   Boolean      @default(false)
  status       ReportStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime     @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterHash, reason])
  @@index([status, createdAt])
  @@index([reviewId])
}

enum ReportReason {
  INAPPROPRIATE
  FAKE
  SPAM
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

/// A photo on the business's profile.
///
/// Separate from Business.coverImage: the cover is the one image that
/// represents the place, these are the rest of it. A caption doubles as
/// the grouping label in the gallery, when the owner bothers to write
/// one.
model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
}

model AvailabilityRule {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int // 0=Sunday … 6=Saturday
  openTime   String // "09:00"
  closeTime  String // "21:00"
  isClosed   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  /// "open now" and "available today" both start from the day column.
  @@index([dayOfWeek, isClosed])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  /// What the business wants to remember about this person.
  notes      String?
  notesUpdatedAt DateTime?
  /// Free-text labels the business invents for itself: "زبون دائم",
  /// "بيتأخر", "حساسية صبغة". An array rather than a join table —
  /// a tag has no properties of its own.
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  /// Visits, cancellations, no-shows and spend are counted from
  /// Booking at read time, never stored here: a stored count is a
  /// count that can be wrong, and a business has hundreds of bookings,
  /// not millions.
  @@unique([businessId, phone])
  @@index([businessId, createdAt])
  @@index([tags], type: Gin)
}

model Booking {
  id                     String        @id @default(cuid())
  businessId             String
  serviceId              String
  customerId             String?
  customerName           String
  customerPhone          String
  /// The phone in canonical form ("201107578212"), computed by the
  /// database from customerPhone — a GENERATED column, never written by
  /// this application. customerPhone keeps whatever the customer typed,
  /// because that is what the business reads and dials; this is what an
  /// account is matched against, since a signed-in customer's phone is
  /// always canonical. Any country (src/lib/phone.ts). Read-only: see
  /// prisma/migrations/international_phone.sql.
  customerPhoneE164      String?
  /// The address typed with this booking, where its emails go. Not the
  /// Customer record's, which an anonymous booking can fill for any
  /// phone number (prisma/migrations/phase17_booking_integrity.sql).
  customerEmail          String?
  date                   DateTime
  startTime              String
  endTime                String?
  status                 BookingStatus @default(PENDING)
  totalPrice             Decimal       @db.Decimal(10, 2)
  currency               String        @default("EGP")
  notes                  String?
  accessToken            String?       @unique // secure random token for customer self-service URL
  /// Human-quotable identifier, e.g. "MWD-7F92K". Unique across the
  /// platform so support can find a booking from it alone.
  reference              String?       @unique
  /// Set by the client on a create request. A retry carrying the same
  /// key returns the original booking instead of making a second one.
  idempotencyKey         String?       @unique
  /// The appointment as an interval, which is what the overlap
  /// constraint in the database is defined over. Derived from date +
  /// startTime/endTime; see lib/bookings/instants.ts for the one place
  /// that computes it.
  startsAt               DateTime?     @db.Timestamp(3)
  endsAt                 DateTime?     @db.Timestamp(3)
  customerReminderSentAt DateTime? // set after reminder is sent — prevents duplicate sends
  depositAmount          Decimal?      @db.Decimal(10, 2) // deposit amount required (null = no deposit)
  paymobOrderId          String? // Paymob order ID for payment tracking
  paymobTransactionId    String? // Paymob transaction ID after successful payment
  // ── Business-type-specific fields ────────────────────────────
  tableId                String? // Deprecated: mirrors resourceId, see Resource
  resourceId             String? // the room / chair / table / equipment held
  staffMemberId          String? // Barbershop: which staff member handles the booking
  branchId               String? // which location, when the business has more than one
  partySize              Int? // Restaurant: number of guests
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  table       Table?       @relation(fields: [tableId], references: [id])
  resource    Resource?    @relation(fields: [resourceId], references: [id])
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  review      Review?
  payments    Payment[]

  /// Where the visitor came from before they booked. Null for bookings
  /// made before attribution existed, and for anything that arrived
  /// without a source — never guessed.
  source      TrafficSource?

  /// What a discount took off, in piastres, for reporting. totalPrice
  /// is already the amount after it — see the Discount model.
  discountCents Int @default(0)
  discountRedemption DiscountRedemption?

  /// Made by the owner through their own unpublished page, to try the
  /// booking flow before going live. Never counted, never notified, and
  /// deleted when the business publishes (lib/business/publish.ts).
  isTest Boolean @default(false)

  /// This table had no indexes at all. Every slot lookup, every dashboard
  /// list and the most-booked sort scanned it.
  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, startsAt])
  @@index([branchId])
  @@index([resourceId])
  @@index([serviceId])
  @@index([customerId])
  @@index([customerPhoneE164])
  @@index([customerPhoneE164, startsAt])
  @@index([staffMemberId])
  @@index([tableId])
}

/// Proves the person signing up controls the email address they gave.
/// Only the hash is stored: a read of this table must not let anyone
/// verify an account they do not own.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// The address being proved, when it is not yet the account's: an
  /// email change takes effect only when this link is followed. Null
  /// for the account's current address (prisma/migrations/phase18_email_change.sql).
  email     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time code sent over WhatsApp to prove a business owns the number
/// every booking notification will be sent to. Hashed, attempt-capped
/// and short-lived.
model PhoneVerification {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([phone])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Restaurant Tables ────────────────────────────────────────
/// Anything with a fixed number of it that an appointment occupies.
///
/// A restaurant calls them tables, a clinic calls them rooms, a salon
/// calls them chairs and a gym calls them equipment. They behave
/// identically — one booking at a time, optionally in a branch,
/// optionally with a capacity — so they are one model. The kind is a
/// label for the owner, never a branch in the scheduling code.
///
/// Supersedes Table, which is kept only so nothing that still reads it
/// breaks; every Table was copied here under the same id.
model Resource {
  id         String       @id @default(cuid())
  businessId String
  branchId   String?
  kind       ResourceKind @default(OTHER)
  name       String
  /// Seats, beds, slots — whatever the kind counts. Null when it does
  /// not count anything.
  capacity   Int?
  /// A free-text zone inside the branch: "الطابق الأول", "الحديقة".
  area       String?
  notes      String?
  photo      String?
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([businessId, isActive, sortOrder])
  @@index([branchId])
}

enum ResourceKind {
  TABLE
  ROOM
  CHAIR
  EQUIPMENT
  OTHER
}

/// Deprecated. Superseded by Resource; see the note there.
model Table {
  id         String    @id @default(cuid())
  businessId String
  name       String // e.g. "T-01", "النافذة", "الزاوية"
  tableType  TableType @default(MIDDLE)
  capacity   Int       @default(4)
  notes      String?
  isActive   Boolean   @default(true)
  photo      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]
  @@index([businessId])

}

// ─── Barbershop Staff ─────────────────────────────────────────
model StaffMember {
  id          String   @id @default(cuid())
  businessId  String
  nameAr      String
  nameEn      String?
  role        String? // barber, stylist, colorist…
  photo       String?
  isActive    Boolean  @default(true)
  workingDays Int[] // dayOfWeek 0-6
  specialties String[] // free-text tags
  /// What this person may do in the business's app, when they sign in
  /// (prisma/migrations/add_staff_access.sql). Null: no app access.
  access      StaffAccess?
  /// The phone that signs in as this staff member, E.164 digits without
  /// the plus. Set by the owner; claimed by the first verified sign-in.
  loginPhone  String?      @unique
  /// The account linked to this staff member. Cleared when the owner
  /// changes the phone or removes access.
  userId      String?      @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  services   StaffService[]
  bookings   Booking[]
  hours      StaffHours[]
  timeBlocks TimeBlock[]

  @@index([businessId, isActive])
}

/// A staff member's own working hours for one weekday.
///
/// workingDays on StaffMember says which days they work; this says
/// when. A member with no rows falls back to the business hours, which
/// is what every existing record does.
model StaffHours {
  id            String  @id @default(cuid())
  staffMemberId String
  dayOfWeek     Int
  startTime     String
  endTime       String
  isOff         Boolean @default(false)

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, dayOfWeek])
}

model StaffService {
  staffMemberId String
  serviceId     String

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffMemberId, serviceId])
  @@index([serviceId])

}

enum AdminRole {
  /// Reported reviews and nothing else.
  MODERATOR
  /// Businesses, customers, bookings, verification and the catalogue.
  ADMIN
  /// Everything, including money and granting roles.
  SUPER_ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// What an administrator did.
///
/// Append-only by convention: nothing writes to a row after creating
/// it and no screen offers a way to. The actor's name and role are
/// copied in rather than joined, because a log that renders whoever
/// holds an id today rewrites its own history the moment somebody is
/// promoted or renamed.
model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  actorId      String?
  actorName    String?
  actorRole    String?
  /// A verb: "business.suspend", "review.hide".
  action       String
  resourceType String
  resourceId   String?
  /// One sentence, readable without decoding the metadata.
  summary      String
  /// What the action needs to be understood later — old and new values,
  /// the reason given. Never credentials, never a customer's contact
  /// details.
  metadata     Json?

  @@index([at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@index([resourceType, resourceId, at(sort: Desc)])
  @@index([action])
}

enum BusinessType {
  GENERAL // default — clinics, gyms, salons, etc.
  RESTAURANT // table-based reservations
  BARBERSHOP // staff-based appointments
}

enum TableType {
  CORNER
  MIDDLE
  OUTDOOR
  WINDOW
  FAMILY
  PRIVATE
  BAR
  BOOTH
}

/// What a signed-in staff member may do (StaffMember.access).
enum StaffAccess {
  MANAGER
  PROVIDER
}

enum BookingStatus {
  PENDING_PAYMENT // awaiting customer deposit payment
  PENDING // payment done (or no deposit required) — awaiting owner confirmation
  CONFIRMED // owner confirmed or auto-confirmed after payment
  ARRIVED // customer is here, not yet being served
  IN_PROGRESS // being served right now
  COMPLETED // appointment finished
  CANCELLED // owner or customer cancelled
  NO_SHOW // customer didn't show up
  FAILED_PAYMENT // payment failed or expired
}

/// Why a stretch of time is unavailable. Kept as one model rather than
/// four, because the availability engine treats them identically — the
/// kind only changes what the owner sees in the calendar.
enum TimeBlockKind {
  BREAK // recurring, e.g. lunch every weekday
  HOLIDAY // whole business shut for a date range
  VACATION // one staff member away
  CLOSURE // one-off, e.g. maintenance
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  INACTIVE
}


// ─── Money ───────────────────────────────────────────────────────────
// Payment state used to live in four nullable string columns —
// paymobOrderId and paymobTransactionId on Booking, and
// subscriptionPaymobOrderId and pendingPlan on Business. That is enough
// to confirm one booking once. It is not enough to hold a second
// payment against the same booking, a refund, a receipt, a failed
// attempt, or an answer to "what did this business actually pay us".

/// What the money was for.
enum PaymentKind {
  BOOKING_DEPOSIT /// part of the price, up front, to hold the slot
  BOOKING_BALANCE /// the rest of it, after a deposit
  BOOKING_FULL /// the whole price in one go
  SUBSCRIPTION /// a business buying a plan
}

/// Where the money came through.
enum PaymentProvider {
  PAYMOB
  MANUAL /// taken in person and recorded by the owner
}

enum PaymentMethod {
  CARD
  WALLET
  CASH
  OTHER
}

/// A payment's life. Only SUCCEEDED means the money arrived, and only
/// the webhook may write it.
enum PaymentStatus {
  PENDING /// session created, customer sent to the provider
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  ABANDONED /// never came back, and the session expired
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One attempt to move money, successful or not.
///
/// A row is written before the customer is sent to Paymob, not after
/// they come back, so an abandoned payment leaves a trace rather than
/// nothing. Nothing but the webhook may set SUCCEEDED.
model Payment {
  id       String          @id @default(cuid())
  kind     PaymentKind
  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider @default(PAYMOB)
  method   PaymentMethod?

  /// Piastres, never pounds. Paymob charges in the minor unit and
  /// rounding between the two is how money goes missing.
  amountCents   Int
  currency      String @default("EGP")
  /// Sum of succeeded refunds against this payment.
  refundedCents Int    @default(0)

  /// The provider's own identifiers. Unique, which is what makes a
  /// replayed webhook a no-op instead of a second confirmation.
  providerOrderId       String? @unique
  providerTransactionId String? @unique

  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Only for SUBSCRIPTION: the plan being bought.
  plan Plan?
  /// Only for SUBSCRIPTION: months bought, 1 or 12 (a year at ten
  /// months' price). The webhook extends the period by this much.
  periodMonths Int @default(1)

  /// Sequential and human-quotable, assigned when the money arrives.
  receiptNumber String?   @unique
  paidAt        DateTime?
  failureReason String?

  /// Who keyed it in, for a payment taken in person.
  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([bookingId])
  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([recordedById])

}

/// Money sent back. Issued by a super admin, never by the business.
model Refund {
  id        String       @id @default(cuid())
  paymentId String
  payment   Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents Int
  status    RefundStatus @default(PENDING)

  providerRefundId String?
  /// Shown to nobody but staff; the reason the money went back.
  reason           String
  failureReason    String?

  /// Copied, not joined: the record should still read correctly if the
  /// account is later removed.
  actorId   String?
  actorName String
  actor     User?   @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status, createdAt])
  @@index([actorId])

}

/// Every webhook the provider has sent us, by its own id.
///
/// This is the idempotency record. Paymob retries anything it did not
/// hear a clean 200 for, and two retries can arrive at once; the unique
/// key means the second insert loses and that delivery does nothing.
model WebhookEvent {
  id       String          @id @default(cuid())
  provider PaymentProvider
  /// The provider's transaction id — what identifies the event itself.
  eventId  String

  /// So a replay that differs from what we stored is visible rather
  /// than silently treated as the same event.
  payloadHash String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// What we did about it, for support to read later.
  outcome     String?

  @@unique([provider, eventId])
  @@index([receivedAt])
}


// ─── Attribution ─────────────────────────────────────────────────────
// "Instagram sent 340 views and 18 of them booked" is answerable.
// "Who was visitor number 204" is deliberately not: nothing here
// identifies a person, and there is no row to join to one.

/// Where a visitor arrived from.
///
/// A closed list rather than free text, so the dashboard can group by
/// it and a typo in a link cannot invent a channel. Anything
/// unrecognised lands in OTHER rather than being dropped, so a link
/// somebody edited by hand still counts as a visit.
enum TrafficSource {
  DIRECT /// typed, bookmarked, or no referrer
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  GOOGLE /// including the Google Business Profile link
  WEBSITE /// the business's own site
  QR /// a printed code in the shop
  MAW3ED /// browsing inside the marketplace
  OTHER
}

/// How many people looked at a business's page, by channel, by day.
///
/// A counter, not a log. One row per business per source per day,
/// incremented — so a hundred thousand views cost one row, and there is
/// nothing in it that could identify who any of them were. No IP, no
/// cookie, no user agent, no device id. That is a design decision, not
/// an omission: the question worth answering is whether a channel
/// works, and that does not require knowing who walked past.
model ProfileView {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     TrafficSource
  /// Calendar day, Africa/Cairo, stored as a bare date.
  day        DateTime      @db.Date
  count      Int           @default(0)

  @@unique([businessId, source, day])
  @@index([businessId, day])
}


// ─── Discounts ───────────────────────────────────────────────────────
// One mechanism wearing two faces. With a code, the customer types it
// and it is a coupon; without one it applies on its own to anything
// matching its rules and it is a promotion. Two models would mean two
// code paths that both reduce a price, and they would drift.

enum DiscountKind {
  PERCENT /// value is 1..100
  FIXED /// value is piastres off
}

/// A reduction a business offers.
///
/// Where the money goes: Booking.totalPrice is stored already reduced —
/// it is what the customer owes, and every deposit, balance and payment
/// calculation reads it without needing to know a discount happened.
/// Booking.discountCents records how much came off, so a report can say
/// what was given away without re-deriving it.
model Discount {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Set: the customer types it — a coupon. Null: it applies by itself
  /// to anything matching — a promotion.
  code   String?
  nameAr String
  nameEn String?

  kind  DiscountKind
  /// Percent for PERCENT, piastres for FIXED. Range-checked in app code
  /// because the meaning depends on kind.
  value Int

  /// Floor before it applies at all, in piastres.
  minSpendCents Int?
  /// Ceiling on what a PERCENT discount may take off. A half-price
  /// offer on an expensive service can cost more than it was meant to.
  maxDiscountCents Int?

  /// Total redemptions allowed, and per customer. Null means no limit.
  maxRedemptions   Int?
  perCustomerLimit Int?
  /// Kept in step inside the booking transaction, so two people cannot
  /// both take the last one.
  redemptionCount  Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  /// Empty means every service. Service ids rather than a relation,
  /// because a service being removed should not delete the offer.
  serviceIds String[] @default([])

  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A code is unique within a business, not globally — two salons may
  /// both run "EID20". Postgres treats NULLs as distinct, so any number
  /// of code-less promotions coexist.
  @@unique([businessId, code])
  @@index([businessId, isActive])
}

/// One use of a discount, against one booking.
model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  /// One per booking, enforced by the database: a booking cannot carry
  /// two discounts, and a retry cannot redeem the same offer twice.
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Who used it, for the per-customer limit. Null for a guest.
  customerId  String?
  amountCents Int

  createdAt DateTime @default(now())

  @@index([discountId])
  @@index([customerId])
}


// ─── Native clients ──────────────────────────────────────────────────
// The web signs in with a NextAuth cookie. A native app cannot use one
// sensibly, so it carries bearer tokens instead — the same session,
// reached a second way, rather than a second authentication system.

/// One signed-in native app, so a refresh token can be revoked.
///
/// A bearer token that cannot be withdrawn is a password that never
/// expires. Signing out, losing a phone, or an admin cutting access all
/// mean deleting a row here, and the next refresh fails.
model MobileSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the person would recognise in a list of their sessions.
  deviceName String?
  platform   String? /// "ios" | "android"

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  /// Past this, refreshing fails however valid the signature.
  expiresAt    DateTime

  /// Which refresh token is the live one. Each refresh carries the
  /// generation it was issued at and advances this by one, so a refresh
  /// token can be used once: presenting an older one means two parties
  /// hold this session, and it is revoked (lib/auth/mobile-refresh.ts).
  refreshGeneration Int       @default(0)
  /// When refreshGeneration last advanced, for the short grace in which
  /// the immediately previous token is still honoured.
  rotatedAt         DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Where to send a push, per device.
///
/// Kept apart from MobileSession on purpose: a push token outlives a
/// sign-out — the device is still the device — and one person may be
/// signed in on two phones.
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The Expo push token. Unique, because the same device re-registering
  /// must update its row rather than collect duplicates and be sent to
  /// twice.
  token    String  @unique
  platform String /// "ios" | "android"

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Set when the provider tells us the token is dead, so the sender
  /// stops trying without the row being lost.
  disabledAt DateTime?

  @@index([userId])
}


/// A fixed-window counter, shared by every serverless instance.
///
/// In-memory rate limiting does not work here: Vercel runs many
/// instances and recycles them, so a Map would give an attacker the
/// whole limit per instance per cold start. Postgres is the one thing
/// they all share.
///
/// The key holds a HASH of whatever is being limited — an address, an
/// email — never the thing itself, and the row expires in minutes. A
/// table of login attempts that named the people attempting them would
/// be a worse disclosure than the attack it guards against.
/// A phone number whose account was deleted, kept as a keyed hash
/// (lib/security/pseudonym.ts) and nothing else. When an account is
/// next created for that number, bookings from before `releasedAt` stay
/// with the businesses but are not shown to the new account: Egyptian
/// numbers are recycled, and the next holder is not the person who
/// booked. The number itself is not stored; without the signing secret
/// the hash cannot be checked against a guess.
model PhoneRelease {
  id         String   @id @default(cuid())
  phoneHash  String   @unique
  releasedAt DateTime @default(now())
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Somebody who searched for a kind of place that is not listed yet
/// and asked to be told when one is: "notify me when a dentist joins".
///
/// What was asked for is kept as typed (lower-cased), with the city if
/// one was chosen, so the list reads as demand: forty people waiting
/// for a dentist in Maadi is a reason to go and sign one up. The email
/// is used for that one message and nothing else, as the form says, and
/// only once its owner has confirmed it: anyone can type an address.
model WaitlistRequest {
  id        String    @id @default(cuid())
  email     String
  /// The search, trimmed and lower-cased.
  query     String
  /// "" when no city was chosen, so the unique key below holds (a null
  /// would make every city-less request distinct).
  citySlug  String    @default("")
  lang      String    @default("ar")
  createdAt DateTime  @default(now())
  /// Hash of the link in the confirmation email; null once confirmed.
  confirmToken String?   @unique
  /// Set when the link is followed. Nothing is sent to an address
  /// before this, the confirmation email aside.
  confirmedAt  DateTime?
  /// Set when the "it is here" message has gone out.
  notifiedAt DateTime?

  @@unique([email, query, citySlug])
  @@index([createdAt])
}

// ─── Phase 21: onboarding, import, lifecycle ─────────────────────────

/// An onboarding wizard in progress, so an owner can stop and come back
/// on any device. One per account; deleted when the business is created.
model OnboardingDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      Int      @default(1)
  /// What the wizard has collected so far, as the client shapes it.
  /// Validated in full only when the business is created.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ImportKind {
  CUSTOMERS
  SERVICES
}

/// One CSV import, so it can be listed and undone. The rows it created
/// are named by id; rolling back removes those that nothing has used
/// since (a customer with a booking stays, and is reported).
model ImportBatch {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind         ImportKind
  createdById  String
  fileName     String?
  rowCount     Int
  createdIds   String[]
  skipped      Int        @default(0)
  createdAt    DateTime   @default(now())
  rolledBackAt DateTime?
  rolledBackCount Int?

  @@index([businessId, createdAt])
}

/// Milestones of a business account, each recorded once, for measuring
/// onboarding. Operational facts about the business's own use of the
/// product — no visitor tracking, no third party, no cookie.
enum LifecycleEventKind {
  BUSINESS_REGISTERED
  ONBOARDING_STARTED
  PROFILE_COMPLETED
  PUBLISHED
  FIRST_BOOKING
  FIRST_COMPLETED_BOOKING
  FIRST_PAID_SUBSCRIPTION
}

model LifecycleEvent {
  id         String             @id @default(cuid())
  /// The account the milestone belongs to: the owner.
  userId     String
  businessId String?
  kind       LifecycleEventKind
  at         DateTime           @default(now())

  @@unique([userId, kind])
  @@index([kind, at])
}
