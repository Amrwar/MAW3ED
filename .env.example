# ─── Required ────────────────────────────────────────────────
# The app refuses to boot without these. See src/lib/env.ts.

# Postgres connection string (Neon). Pooled connection.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (unpooled) connection, used by migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# NextAuth signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-at-least-16-characters"
# The v4 name NextAuth still accepts; set one of the two, not both.
NEXTAUTH_SECRET=""
# Keys the hash of phone numbers released by deleted accounts
# (lib/security/pseudonym.ts). Set once, before go-live, and NEVER
# rotate: the hashes cannot be re-keyed and the fence would drop.
# Falls back to AUTH_SECRET when unset (local only).
PSEUDONYM_SECRET=""

# ─── Public origin ───────────────────────────────────────────
# Canonical URLs, sitemap, robots.txt, JSON-LD, auth redirects,
# password-reset links and referral links all derive from this.
# Must be the real domain in production — no trailing slash.
AUTH_URL="http://localhost:3000"

# ─── Cron ────────────────────────────────────────────────────
# Shared secret the Vercel cron jobs present. See vercel.json.
CRON_SECRET=""

# ─── Email (Resend) — optional ───────────────────────────────
# RESEND_API_KEY alone decides whether mail is sent at all. EMAIL_FROM
# falls back to the value below if unset, so the key is the real switch.
#
# With no key: password reset and "resend verification link" answer 503
# rather than claiming to have sent something, and booking/subscription
# notifications are skipped and logged. Everything else works.
#
# The sending domain must be verified in Resend or sends are refused.
RESEND_API_KEY=""
EMAIL_FROM="Maw3ed <noreply@maw3ed.net>"

# Where the contact page and the FAQ tell users to write, and the
# address they are promised a reply from within 24 hours. Defaults to
# support@maw3ed.net. Set it for any deployment that is not production
# — a fork or a preview build should not point people at the real
# support inbox. Public by nature: it is printed on a public page.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# ─── Payments (Paymob) — optional ────────────────────────────
# All four are needed together or payments are disabled.
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_IFRAME_ID=""
PAYMOB_INTEGRATION_ID=""

# ─── Local QA only: fake Paymob checkout ────────────────────
# Never set in production (it is refused there anyway). Lets a deposit
# booking reach the real webhook and confirmation without Paymob keys.
# PAYMOB_HMAC_SECRET must still be set, to sign the fake callbacks.
# Set PAYMOB_FAKE="1" to turn it on; the URLs are how a phone on the LAN
# reaches this machine, e.g. "http://192.168.1.10:3000".
PAYMOB_FAKE=""
PAYMOB_FAKE_BASE_URL=""
PAYMOB_FAKE_RETURN_URL=""

# ─── Visitor access (Phase 23) — optional ───────────────────
# 32 random bytes, base64 (openssl rand -base64 32). Keys the booking
# check-in codes and encrypts stored visitor-pass tokens. Without it a
# key per purpose is derived from AUTH_SECRET. Changing it re-issues
# every check-in code and makes stored pass tokens unreadable.
ACCESS_CREDENTIAL_KEY=""
# Local QA only: "1" lets the sandbox access provider (not valid at any
# gate) run in a production build on this machine. Refused on Vercel.
ACCESS_SANDBOX=""

# ─── Push notifications (Expo) — optional ────────────────────
# Without it push still sends. With "enhanced push security" turned on in
# the Expo dashboard, set it here and Expo refuses pushes without it.
# See docs/push-setup.md.
EXPO_ACCESS_TOKEN=""

# ─── WhatsApp Cloud API — optional ───────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Name of the approved "authentication" template that carries sign-in
# codes (body {{1}} = the code, copy-code button). Required in production:
# Meta does not deliver free-text codes outside the 24-hour window.
WHATSAPP_TEMPLATE_AUTH_CODE=""
# "1" = a guest booking must confirm its phone number with a WhatsApp code
# first (signed-in customers already have). Off until codes are delivered:
# with it on and WhatsApp not sending, no guest can book.
BOOKING_PHONE_VERIFICATION=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_DEFAULT_LANGUAGE_CODE="ar"
WHATSAPP_TEMPLATE_CUSTOMER_CONFIRMATION=""
WHATSAPP_TEMPLATE_CUSTOMER_REMINDER=""
WHATSAPP_TEMPLATE_BUSINESS_NEW_BOOKING=""

# ─── Image uploads (Cloudinary) — optional ───────────────────
# All three are needed together or uploads are disabled.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Error tracking (Sentry) — optional ──────────────────────
# Leave empty and Sentry stays completely off: the SDK is inert, no
# events are sent and the build wrapper is a no-op.
# The DSN is safe to expose; the auth token is not.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Only needed to upload source maps at build time.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── SMS — optional, and currently dormant ─────────────
# No gateway is wired up. Without a URL and a key the SMS channel
# reports "sms-not-configured" and the notification ledger records that
# plainly — it does not pretend to have sent anything. Preferences,
# deduplication and the ledger already treat SMS as a real channel, so
# wiring a provider is one function in notifications/channels.ts.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="MAW3ED"

# ─── App links (mobile) — optional ───────────────────────────
# Served at /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json so maw3ed.net links open the app.
# Unset: both answer 404 and links open in the browser.
# APPLE_TEAM_ID: from developer.apple.com → Membership.
# ANDROID_CERT_SHA256: `eas credentials` → Android → SHA-256, comma-separated.
APPLE_TEAM_ID=""
ANDROID_CERT_SHA256=""

# ─── Public origin — optional ───────────────────────
# Canonical URLs, the sitemap, robots.txt, JSON-LD, referral links and
# the links inside password-reset emails all derive from the origin.
# Resolution order is AUTH_URL (set above), then NEXTAUTH_URL, then
# NEXT_PUBLIC_SITE_URL, then the Vercel-provided URL. Set at least one
# in production or emailed links point at the wrong host. These two are
# the fallbacks; AUTH_URL alone is enough.
NEXTAUTH_URL=""
NEXT_PUBLIC_SITE_URL=""

# The bare domain, without a scheme, as printed in page copy.
# Defaults to maw3ed.net.
NEXT_PUBLIC_SITE_HOST=""

# ─── Support WhatsApp — optional ─────────────────────────────
# The number visitors can message from /contact, in local or
# international form (01XXXXXXXXX or 201XXXXXXXXX).
# Unset means the WhatsApp card is not shown at all, rather than
# shown with nothing behind it.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
