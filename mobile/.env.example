# ─── Mobile environment ──────────────────────────────────────────────
# Copy to .env for local development. Nothing here is secret: anything
# prefixed EXPO_PUBLIC_ is compiled into the app binary and readable by
# anyone who downloads it. Secrets belong on the server, never here.

# Where the app talks to. A phone cannot reach "localhost" — that is the
# phone itself — so use the LAN address of the machine running
# `npm run dev` in the web project, or an ngrok/Expo tunnel URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Which configuration to build: development | staging | production.
# EAS sets this per build profile; set it here only to override locally.
APP_ENV=development

# From `eas init`. Not a secret, but it belongs to your EAS project.
EAS_PROJECT_ID=
